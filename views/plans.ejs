<!doctype html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Construction Plans' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <!-- Hero Banner -->
    <div class="container-fluid bg-image-banners" style="background-image: url('/asset/construction1.jpeg');">
        <div class="bg-image-banners-overlay"></div>
        <div class="jumbotron text-center">
            <div class="jumbotron-content" data-aos="fade-up">
                <h1 class="display-1">Construction Plans & Pricing</h1>
                <h5>"Transparent Estimates, Premium Workmanship, Guaranteed Durability"</h5>
            </div>
        </div>
    </div>

    <!-- Pricing Plans Section -->
    <div class="container py-5">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="fw-bold">Tailored Packages For Every Project</h2>
            <p class="text-muted">Choose from our carefully engineered construction packages or request a custom turnkey estimate.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Plan 1 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-right">
                <div class="card h-100 border shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white text-center py-4">
                        <h4 class="fw-bold mb-1">Standard Package</h4>
                        <span class="badge bg-warning text-dark px-3 py-2 mt-2">Essential Quality</span>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <ul class="list-unstyled mb-4">
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Standard Grade Branded Cement (ACC / Ambuja)</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> High-tensile Fe-550D TMT Steel Bars</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Standard Vitrified Tile Flooring</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> High-grade Red Brick Masonry</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Asian Paints Exterior & Interior Primers</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> 3-Year Structural Warranty</li>
                        </ul>
                        <a href="/contact" class="btn btn-outline-dark w-100 py-2 fw-bold">Request Quotation</a>
                    </div>
                </div>
            </div>

            <!-- Plan 2 (Featured) -->
            <div class="col-lg-4 col-md-6" data-aos="fade-up">
                <div class="card h-100 border-2 border-warning shadow-lg rounded-4 overflow-hidden position-relative">
                    <div class="card-header bg-warning text-dark text-center py-4">
                        <h4 class="fw-bold mb-1">Premium Package</h4>
                        <span class="badge bg-dark text-white px-3 py-2 mt-2">Most Popular Choice</span>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <ul class="list-unstyled mb-4">
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> UltraTech / Ambuja Top-Grade Cement</li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> Premium Fe-550D Rust-Resistant TMT Steel</li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> Designer Vitrified & Granite Floor Finishes</li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> Asian Paints Royale Luxury Interior Finish</li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> Complete 3D Architectural Blueprint & 2D Layouts</li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> <strong>5-Year Comprehensive Guarantee Scheme</strong></li>
                            <li class="mb-3"><i class="fa fa-check text-success me-2"></i> Dedicated Structural Site Supervisor</li>
                        </ul>
                        <a href="/contact" class="btn btn-yellow w-100 py-2 fw-bold">Get Instant Estimate</a>
                    </div>
                </div>
            </div>

            <!-- Plan 3 -->
            <div class="col-lg-4 col-md-6" data-aos="fade-left">
                <div class="card h-100 border shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white text-center py-4">
                        <h4 class="fw-bold mb-1">Turnkey Luxury</h4>
                        <span class="badge bg-warning text-dark px-3 py-2 mt-2">Villas & Commercial</span>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <ul class="list-unstyled mb-4">
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Italian Marble / Hardwood Flooring Options</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Smart Home Automation Conduit Wiring</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Modern False Ceiling & Concealed Ambient Lighting</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Customized Landscape & Terrace Patio Design</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> Premium Modular Kitchen with Granite Countertops</li>
                            <li class="mb-3"><i class="fa fa-check text-warning me-2"></i> 10-Year Structural Integrity Assurance</li>
                        </ul>
                        <a href="/contact" class="btn btn-outline-dark w-100 py-2 fw-bold">Schedule Consultation</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Guarantee Scheme Highlight Banner -->
        <div class="card bg-dark text-white mt-5 p-4 rounded-4 shadow" data-aos="fade-up">
            <div class="card-body d-md-flex align-items-center justify-content-between">
                <div class="me-md-4">
                    <h3 class="text-warning fw-bold mb-2"><i class="fa fa-shield-alt me-2"></i> 5-Year Issuance & Guarantee Scheme</h3>
                    <p class="mb-0 text-light">Every project we execute is protected against material defects and structural faults with free prompt maintenance.</p>
                </div>
                <div class="mt-3 mt-md-0 text-nowrap">
                    <a href="/contact" class="btn btn-yellow fw-bold px-4 py-3">Book Site Visit</a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
